{
  "datasets": [
    {
      "name": "96cf5c92",
      "displayName": "executive_overview",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS total_orders,\r\n",
        "\r\n",
        "    SUM(CASE\r\n",
        "        WHEN order_status = 'delivered' THEN 1\r\n",
        "        ELSE 0\r\n",
        "    END) AS delivered_orders,\r\n",
        "\r\n",
        "    ROUND(SUM(total_price), 2) AS total_revenue,\r\n",
        "\r\n",
        "    ROUND(SUM(total_freight_value), 2) AS total_freight,\r\n",
        "\r\n",
        "    ROUND(SUM(total_item_value), 2) AS total_order_value,\r\n",
        "\r\n",
        "    ROUND(AVG(total_item_value), 2) AS avg_order_value,\r\n",
        "\r\n",
        "    ROUND(AVG(delivery_days), 2) AS avg_delivery_days\r\n",
        "\r\n",
        "FROM workspace.olist.gold_order_analytics;"
      ]
    },
    {
      "name": "04467d78",
      "displayName": "monthly_order_trend",
      "queryLines": [
        "SELECT\r\n",
        "    DATE_FORMAT(order_purchase_timestamp, 'yyyy-MM') AS order_month,\r\n",
        "    COUNT(DISTINCT order_id) AS total_orders\r\n",
        "FROM workspace.olist.silver_orders\r\n",
        "GROUP BY DATE_FORMAT(order_purchase_timestamp, 'yyyy-MM')\r\n",
        "ORDER BY order_month;"
      ]
    },
    {
      "name": "ef0b8383",
      "displayName": "order_status_distribution",
      "queryLines": [
        "SELECT\r\n",
        "    order_status,\r\n",
        "    COUNT(DISTINCT order_id) AS total_orders\r\n",
        "FROM workspace.olist.silver_orders\r\n",
        "GROUP BY order_status\r\n",
        "ORDER BY total_orders DESC;"
      ]
    },
    {
      "name": "178136e5",
      "displayName": "delivery_performance",
      "queryLines": [
        "SELECT\r\n",
        "    CASE\r\n",
        "        WHEN order_delivered_customer_date\r\n",
        "             <= order_estimated_delivery_date\r\n",
        "        THEN 'On Time'\r\n",
        "        WHEN order_delivered_customer_date\r\n",
        "             > order_estimated_delivery_date\r\n",
        "        THEN 'Late'\r\n",
        "    END AS delivery_status,\r\n",
        "\r\n",
        "    COUNT(DISTINCT order_id) AS total_orders\r\n",
        "\r\n",
        "FROM workspace.olist.gold_order_analytics\r\n",
        "\r\n",
        "WHERE order_status = 'delivered'\r\n",
        "  AND order_delivered_customer_date IS NOT NULL\r\n",
        "  AND order_estimated_delivery_date IS NOT NULL\r\n",
        "\r\n",
        "GROUP BY\r\n",
        "    CASE\r\n",
        "        WHEN order_delivered_customer_date\r\n",
        "             <= order_estimated_delivery_date\r\n",
        "        THEN 'On Time'\r\n",
        "        WHEN order_delivered_customer_date\r\n",
        "             > order_estimated_delivery_date\r\n",
        "        THEN 'Late'\r\n",
        "    END;"
      ]
    },
    {
      "name": "8fa73f26",
      "displayName": "category_performance_preview",
      "queryLines": [
        "SELECT *\r\n",
        "FROM workspace.olist.gold_category_performance\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "c80c2f96",
      "displayName": "top_10_categories_revenue",
      "queryLines": [
        "SELECT\r\n",
        "    product_category_name,\r\n",
        "    total_revenue\r\n",
        "FROM workspace.olist.gold_category_performance\r\n",
        "WHERE product_category_name IS NOT NULL\r\n",
        "ORDER BY total_revenue DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "799e2d4f",
      "displayName": "top_10_categories_units",
      "queryLines": [
        "SELECT\r\n",
        "    product_category_name,\r\n",
        "    total_units_sold\r\n",
        "FROM workspace.olist.gold_category_performance\r\n",
        "WHERE product_category_name IS NOT NULL\r\n",
        "ORDER BY total_units_sold DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "customer_repeat_analysis",
      "displayName": "customer_repeat_analysis",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN total_orders > 1 THEN 'Repeat Customers'\n",
        "    ELSE 'One-Time Customers'\n",
        "  END AS customer_type,\n",
        "  COUNT(DISTINCT customer_unique_id) AS total_customers\n",
        "FROM\n",
        "  gold_customer_analytics\n",
        "GROUP BY\n",
        "  1;"
      ],
      "catalog": "workspace",
      "schema": "olist"
    },
    {
      "name": "top_customers_spending",
      "displayName": "top_10_customers_spending",
      "queryLines": [
        "SELECT\n",
        "  customer_unique_id,\n",
        "  total_orders,\n",
        "  total_spending,\n",
        "  avg_order_value,\n",
        "  total_items_purchased\n",
        "FROM\n",
        "  gold_customer_analytics\n",
        "WHERE\n",
        "  customer_unique_id IS NOT NULL\n",
        "ORDER BY\n",
        "  total_spending DESC\n",
        "LIMIT 10;"
      ],
      "catalog": "workspace",
      "schema": "olist"
    },
    {
      "name": "top_sellers_revenue",
      "displayName": "top_10_sellers_revenue",
      "queryLines": [
        "SELECT\n",
        "  seller_id,\n",
        "  total_revenue\n",
        "FROM\n",
        "  gold_seller_analytics\n",
        "WHERE\n",
        "  seller_id IS NOT NULL\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10;"
      ],
      "catalog": "workspace",
      "schema": "olist"
    },
    {
      "name": "seller_state_revenue",
      "displayName": "seller_state_revenue",
      "queryLines": [
        "SELECT\n",
        "  seller_state,\n",
        "  total_revenue\n",
        "FROM\n",
        "  gold_seller_state_performance\n",
        "WHERE\n",
        "  seller_state IS NOT NULL\n",
        "ORDER BY\n",
        "  total_revenue DESC;"
      ],
      "catalog": "workspace",
      "schema": "olist"
    },
    {
      "name": "top_categories_avg_price",
      "displayName": "top_10_categories_avg_price",
      "queryLines": [
        "SELECT\n",
        "  product_category_name,\n",
        "  avg_selling_price\n",
        "FROM\n",
        "  gold_category_performance\n",
        "WHERE\n",
        "  product_category_name IS NOT NULL\n",
        "ORDER BY\n",
        "  avg_selling_price DESC\n",
        "LIMIT 10;"
      ],
      "catalog": "workspace",
      "schema": "olist"
    }
  ],
